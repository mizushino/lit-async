{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "node",
    "rootDir": "./src",
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "lib": ["es2021", "dom"],
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "examples"]
}
